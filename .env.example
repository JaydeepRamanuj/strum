# Copy this file to .env.local and fill in your values. .env.local is git-ignored.
# Everything here is public by design (it ends up in the browser); never put a secret in it.

# Firebase → Project settings → General → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary → cloud name, and the name of your *unsigned* upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional
# Largest file a user can upload, in MB (default and limit are in src/config/env.ts)
# VITE_MAX_UPLOAD_MB=
# "128k" streams a smaller copy to save Cloudinary bandwidth; "original" streams the file as uploaded
# VITE_STREAM_QUALITY=128k
