rules_version = '2';

// Strum — Firestore security rules (docs/phase-1-auth.md, data model in docs/README.md).
// Publish by pasting this file into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isFriend() {
      return verified()
        && exists(/databases/$(database)/documents/allowedUsers/$(email()));
    }
    function isAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/admins/$(email()));
    }
    function isMe(uid) { return isFriend() && request.auth.uid == uid; }

    // Admins: one doc per owner, added by hand in the console (docs/README.md → Invites).
    // Nobody can list or write it from the client.
    match /admins/{e} {
      allow get:   if signedIn() && e == email();
      allow list, write: if false;
    }

    // Friend allowlist. A user may check their own entry. Admins can list and remove friends.
    // Friends join in two ways: an admin adds the entry, or a verified user redeems an invite
    // by creating their own entry that points at a live invite code.
    match /allowedUsers/{e} {
      allow get:    if signedIn() && e == email();
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        || (verified() && e == email() && validRedemption(request.resource.data));
      allow update: if false;
    }

    // Invite codes. Only admins create or list them. Anyone signed in with a verified email can
    // read one invite by its exact code (codes are random and long, so they can't be guessed).
    // Redeeming may only increment `uses`; the expiry and limit can't be changed.
    match /invites/{code} {
      allow get:    if verified();
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        && validInvite(request.resource.data)
        && request.resource.data.createdBy == email();
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && resource.data.uses < resource.data.maxUses
        && resource.data.expiresAt > request.time;
    }

    // Discover: a public copy of a song its owner chose to share (docs/README.md, Data model).
    // Any friend can read them. The owner writes them, and only while their own private song
    // (same id) is public and not deleted after the same batch, so the two stay in step. Every
    // copy also holds a claim on its title+artist (publicKeys, below), so a song can be public
    // only once. An admin may fix a copy's descriptive fields (title, artist, album, cover).
    // Deleting a doc that doesn't exist is allowed, so a soft delete needn't check first.
    match /publicSongs/{songId} {
      allow read: if isFriend();
      allow create: if isFriend()
        && request.resource.data.ownerUid == request.auth.uid
        && validPublicSong(request.resource.data)
        && claimAfter(songId, request.resource.data.dupKey)
        && ownSongIsPublic(songId);
      allow update: if isFriend()
        && validPublicSong(request.resource.data)
        && claimAfter(songId, request.resource.data.dupKey)
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && ownSongIsPublic(songId))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminSongFields())
            && songIsPublicAfter(resource.data.ownerUid, songId))
        );
      allow delete: if isFriend()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // Discover: a public copy of a playlist its owner shared. The owner writes it, and only while
    // their own playlist (same id) is public after the same batch and has the same name,
    // description and song list, so the two can't differ. Rules can't check that every song is
    // public; the app only puts public songs in and Discover hides any that stop being public.
    match /publicPlaylists/{playlistId} {
      allow read: if isFriend();
      allow create, update: if isFriend()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && validPublicPlaylist(request.resource.data)
        && ownPlaylistMatches(playlistId, request.resource.data);
      allow delete: if isFriend()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // One claim per normalised title+artist (the id is the key, see src/lib/songKey.ts). Creating
    // one fails if it already exists, which is what stops a second copy of a song from going
    // public, even if two people try at once. A claim must point at the public song that holds it
    // (same batch). The owner releases it when unsharing; an admin can create or release any.
    match /publicKeys/{key} {
      allow read: if isFriend();
      allow create: if isFriend()
        && validClaim(key, request.resource.data)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isFriend()
        && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /songs/{songId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && validSong(request.resource.data);
        // An admin may fix the descriptive fields of a song that is public (Discover edit).
        allow update: if (isMe(uid) && validSong(request.resource.data))
          || (isAdmin()
            && resource.data.isPublic == true
            && resource.data.deleted == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminSongFields())
            && validSong(request.resource.data));
      }
      match /playlists/{playlistId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validPlaylist(request.resource.data);
      }
      // Play counts for Top songs. A play adds exactly 1 to the count; only this user sees them.
      match /playStats/{songId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && validPlayStat(request.resource.data)
          && request.resource.data.count == 1;
        allow update: if isMe(uid)
          && validPlayStat(request.resource.data)
          && request.resource.data.count == resource.data.count + 1;
      }
      match /folders/{folderId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validFolder(request.resource.data);
      }
    }

    function validSong(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.artist is string && d.artist.size() <= 200
        && d.cloudinaryPublicId is string
        && d.audioUrl is string && d.audioUrl.matches('https://res\\.cloudinary\\.com/.*')
        && d.durationSec is number
        && d.deleted is bool
        && (!('isPublic' in d) || d.isPublic is bool)
        && (!('dupKey' in d) || d.dupKey == null || (d.dupKey is string && d.dupKey.size() <= 300));
    }
    // Fields an admin may change on a public song and its private original.
    function adminSongFields() {
      return ['title', 'artist', 'album', 'coverPublicId', 'coverUrl', 'searchKeywords', 'dupKey'];
    }
    function validPublicSong(d) {
      return d.ownerUid is string
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 100
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.artist is string && d.artist.size() <= 200
        && d.cloudinaryPublicId is string
        && d.audioUrl is string && d.audioUrl.matches('https://res\\.cloudinary\\.com/.*')
        && d.durationSec is number
        && d.searchKeywords is list
        && d.dupKey is string && d.dupKey.size() > 0 && d.dupKey.size() <= 300
        && d.sharedAt is timestamp;
    }
    // The claim on `key` points at this song once the batch is applied.
    function claimAfter(songId, key) {
      let claim = /databases/$(database)/documents/publicKeys/$(key);
      return existsAfter(claim) && getAfter(claim).data.songId == songId;
    }
    // A new claim names the public song that holds it, and that song's owner and key match.
    function validClaim(key, d) {
      let pub = /databases/$(database)/documents/publicSongs/$(d.songId);
      return d.songId is string
        && d.ownerUid is string
        && d.createdAt is timestamp
        && existsAfter(pub)
        && getAfter(pub).data.dupKey == key
        && getAfter(pub).data.ownerUid == d.ownerUid;
    }
    // The caller's own private song with this id, as it will be after this write/batch.
    function ownSongIsPublic(songId) {
      return songIsPublicAfter(request.auth.uid, songId);
    }
    function songIsPublicAfter(uid, songId) {
      let path = /databases/$(database)/documents/users/$(uid)/songs/$(songId);
      return existsAfter(path)
        && getAfter(path).data.isPublic == true
        && getAfter(path).data.deleted == false;
    }
    function validPlaylist(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.songIds is list && d.songIds.size() <= 5000
        && (!('isPublic' in d) || d.isPublic is bool);
    }
    function validPublicPlaylist(d) {
      return d.ownerUid is string
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && (d.description == null || (d.description is string && d.description.size() <= 500))
        && (d.coverUrl == null || d.coverUrl is string)
        && d.songIds is list && d.songIds.size() <= 5000
        && d.sharedAt is timestamp
        && d.updatedAt is timestamp;
    }
    // The caller's own playlist with this id, as it will be after this write/batch, is public and
    // has the same name, description and songs as the public copy `d`.
    function ownPlaylistMatches(playlistId, d) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/playlists/$(playlistId);
      return existsAfter(path)
        && getAfter(path).data.isPublic == true
        && getAfter(path).data.name == d.name
        && getAfter(path).data.get('description', null) == d.description
        && getAfter(path).data.songIds == d.songIds;
    }
    function validPlayStat(d) {
      return d.count is int && d.count >= 1
        && d.lastPlayedAt is timestamp
        && d.keys().hasOnly(['count', 'lastPlayedAt']);
    }
    function validFolder(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }
    function validInvite(d) {
      return d.createdBy is string
        && d.createdAt is timestamp
        && d.expiresAt is timestamp
        && d.maxUses is int && d.maxUses >= 1 && d.maxUses <= 50
        && d.uses == 0
        && d.note is string && d.note.size() <= 100;
    }
    // A redemption must name a live invite (not expired, uses left) and carry the timestamp.
    function validRedemption(d) {
      return d.inviteCode is string
        && d.addedAt is timestamp
        && exists(/databases/$(database)/documents/invites/$(d.inviteCode))
        && get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.uses
             < get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.maxUses;
    }
  }
}
